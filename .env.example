STT_DATA=./data
STT_ADMIN_KEY=generate-a-random-secret
STT_WORKER_KEY=generate-another-random-secret
STT_EDGE_KEY=generate-a-third-random-secret
STT_REQUIRE_EDGE=0
STT_URL=http://127.0.0.1:8765
STT_WORKER_ID=worker-01

# Optional remote Tunnel without a pasted token (Wrangler OAuth login required):
# STT_TUNNEL_NAME=faysk-stt

# Optional S7 Edge SSH management target (private .env only, never credentials):
# STT_S7_SSH_HOST=<local-ip-or-hostname>
# STT_S7_SSH_USER=<termux-user>
# STT_S7_SSH_PORT=8022
# SSH alone does not register an STT worker or enable transcription.

# S7-native worker is a separate Android/Termux client, not the SSH card.
# Generate a DISTINCT random 64-hex token locally; keep only in private .env.
# STT_S7_WORKER_KEY=<unique-64-hex-secret>
# STT_S7_ENABLED=0
# Enabled only after API publication and verified live S7 client.
